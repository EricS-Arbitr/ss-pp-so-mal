{
  "policy_id": "{{ item.policy }}",
  "package": { "name": "{{ item.package }}", "version": "" },
  "name": "{{ item.name }}",
  "namespace": "default",
  "description": "Managed by so_fleet_integrations (Ansible). Do not edit in SOC.",
  "inputs": {
    "{{ item.input }}": {
      "enabled": true,
      "streams": {
        "filestream.generic": {
          "enabled": true,
          "vars": {
            "paths": [{% for h in item.path_hosts %}"/var/log/remote/{{ h }}/syslog.log"{% if not loop.last %}, {% endif %}{% endfor %}],
            "data_stream.dataset": "{{ item.dataset }}",
            "exclude_lines": {{ item.exclude_lines | to_json }},
            "tags": ["vyos", "forwarded"]
          }
        }
      }
    }
  }
}
