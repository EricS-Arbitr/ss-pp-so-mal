################################################################
# /etc/rsyslog.d/30-remote.conf — central syslog collector
# Managed by Ansible (syslog_server role). Do not edit by hand.
################################################################

# Receive on UDP 514
module(load="imudp")
input(type="imudp" port="514")

# Receive on TCP 514
module(load="imtcp")
input(type="imtcp" port="514")

# Per-host file template:
#   /var/log/remote/<hostname>/syslog.log
# VyOS sends short hostnames, Linux uses %HOSTNAME% from /etc/hostname.
# pfSense sends NO resolvable hostname -- verified 2026-09-10, its
# directories are bare addresses (172.16.0.9/.18/.25/.50) while the routers
# appear by name. Anything matching pfSense messages must key on
# $fromhost-ip, not $hostname. The directory name remains the attribution
# for whatever reads this store.
template(
  name="RemoteHostFile"
  type="list"
) {
  constant(value="/var/log/remote/")
  property(name="hostname" securepath="replace")
  constant(value="/syslog.log")
}

# Route only remote messages (anything not from localhost) into the per-host
# files and then stop processing so they don't also land in /var/log/syslog.
# Local rsyslog/journald messages keep their normal path.
#
# THE `stop` ENDS PROCESSING FOR EVERY REMOTE MESSAGE. Any rule that needs to
# see remote logs must live in a file sorting BEFORE this one --
# see 29-fleet-forward.conf, which relays firewall messages to the local
# Elastic agent and was silently dead while numbered 31-.
if $fromhost-ip != '127.0.0.1' then {
    action(
      type="omfile"
      dynaFile="RemoteHostFile"
      createDirs="on"
      fileCreateMode="0640"
      dirCreateMode="0755"
      fileOwner="syslog"
      fileGroup="adm"
    )
    stop
}
